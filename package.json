{
  "name": "harmony-harness-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "demo": "bun run src/cli/main.ts demo",
    "demo:auto": "HARMONY_PLANNER=fixture bun run src/cli/main.ts demo --auto",
    "benchmark": "bun run src/cli/main.ts benchmark live",
    "benchmark:replay": "bun run src/cli/main.ts benchmark replay",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/ai-openrouter": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.2"
  }
}
